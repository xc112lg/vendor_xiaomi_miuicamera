index 0000000..6c10800
--- /dev/null
+++ b/sepolicy/system_ext/seapp_contexts
@@ -0,0 +1 @@
+user=_app isPrivApp=true name=com.android.camera domain=miuicamera_app type=privapp_data_file levelFrom=all
